FLUTTER_ROOT=E:\project\.tooling\flutter
FLUTTER_APPLICATION_PATH=E:\project\vendor-app-main
FLUTTER_FRAMEWORK_SWIFT_PACKAGE_PATH=E:\project\vendor-app-main\ios\Flutter\ephemeral\Packages\.packages\FlutterFramework
COCOAPODS_PARALLEL_CODE_SIGN=true
FLUTTER_TARGET=lib\main.dart
FLUTTER_BUILD_DIR=build
FLUTTER_BUILD_NAME=1.0.3
FLUTTER_BUILD_NUMBER=5
DART_OBFUSCATION=false
TRACK_WIDGET_CREATION=true
TREE_SHAKE_ICONS=false
PACKAGE_CONFIG=.dart_tool/package_config.json
